# Online Club — nginx reverse-proxy example (single VPS, one domain).
# Serves the built web client statically and proxies /api/* to the API.
# Install: copy to /etc/nginx/sites-available/online-club, symlink to
# sites-enabled, set server_name, then: certbot --nginx -d your-domain.com

upstream club_api {
    server 127.0.0.1:4000;
}

server {
    listen 80;
    server_name your-domain.com;

    # Built web client (npm run build → client/dist)
    root /opt/online-club/client/dist;
    index index.html;

    # API + docs
    location /api/ {
        proxy_pass http://club_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache static assets
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
