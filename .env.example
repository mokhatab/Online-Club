# ------------------------------------------------------------------
# Online Club — environment template. Copy to .env and adjust.
# ------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# URL the API is reachable at (used in docs + webhook receiver URLs)
API_PUBLIC_URL=http://localhost:4000

# Comma-separated origins allowed to call the API (the web client)
CORS_ORIGINS=http://localhost:5173

# SQLite database file (created automatically). Use :memory: for tests.
DATABASE_PATH=./data/online-club.db

# Change this to a long random string in production!
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Seed demo data on first boot (admin + members + events)
SEED_ON_BOOT=true
SEED_ADMIN_EMAIL=admin@onlineclub.local
SEED_ADMIN_PASSWORD=Admin123!

# Client (Vite) — where the browser should reach the API
VITE_API_URL=http://localhost:4000/api/v1
